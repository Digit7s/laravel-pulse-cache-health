{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "digit7s/laravel-pulse-cache-health",
    "description": "Read-only MySQL database cache storage metadata for Laravel Pulse.",
    "keywords": [
        "digit7s",
        "laravel",
        "pulse",
        "cache",
        "database",
        "monitoring"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Digit7s"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/pulse": "~1.8.1",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Digit7s\\PulseCacheHealth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Digit7s\\PulseCacheHealth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:mysql": "pest tests/Integration",
        "test:mysql:required": "pest tests/Integration --fail-on-skipped",
        "lint": "pint --test",
        "format": "pint",
        "validate:composer": "composer validate --strict"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Digit7s\\PulseCacheHealth\\PulseCacheHealthServiceProvider"
            ]
        }
    }
}
